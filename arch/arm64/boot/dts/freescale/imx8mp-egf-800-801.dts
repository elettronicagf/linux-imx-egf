 &ecspi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi1 &pinctrl_ecspi1_cs>;
	cs-gpios = <&gpio5 9 GPIO_ACTIVE_LOW>;
	status = "okay";

    adc@0 {
		compatible = "ti,adc122s021";
		reg = <0>;
		spi-max-frequency = <1000000>;
		#io-channel-cells = <1>;
    };
};

 &ecspi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2 &pinctrl_ecspi2_cs>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
	status = "okay";

    adc@0 {
		compatible = "ti,adc122s021";
		reg = <0>;
		spi-max-frequency = <1000000>;
		#io-channel-cells = <1>;
    };
};



 &eqos {
	status = "okay";
};


&fec {
	status = "okay";
};



&flexcan1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	status = "okay";
};

&flexcan2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan2>;
	status = "okay";
};

&i2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	status = "okay";

		// RTC carrier
		pcf85063: rtc@51 {
			compatible = "nxp,pcf85063a";
			reg = <0x51>;
			quartz-load-femtofarads = <7000>;
		};
	
		// EEPROM carrier
		24c64@56 {
			compatible = "fsl,24c64";
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_eeprom_carrier>;
			reg = <0x56>;
			pagesize = <32>;
		};
	
	
		pca9632@62 {
			compatible = "nxp,pca9632";
			#address-cells = <1>;
			#size-cells = <0>;
			nxp,totem-pole;
			nxp,inverted-out;
			reg = <0x62>;
	
	
			mipi_dsi_led: dsi0@0 {
				reg = <0>;
				linux,default-trigger = "none";
			};
	
			lvds0_bl_led: dis0@1 {
				reg = <1>;
				linux,default-trigger = "none";
			};
		};
		
		gpio_exp_3v3: gpio@21 {
			compatible = "nxp,tca6408";
			reg = <0x21>;
			gpio-controller;
			#gpio-cells = <2>;
		};
		
		nau8822_1a: nau8822@1a {
			compatible = "nuvoton,nau8822";
			reg = <0x1a>;
			#sound-dai-cells = <0>;
		};
};

&i2c3 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c3>;
	status = "okay";

	tca6416: gpio@21 {
		compatible = "ti,tca6416";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
	};
	
	gpios_exp: gpio@20 {	
		compatible = "nxp,pcal6416";
		#address-cells = <1>;
		#size-cells = <0>;
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x20>;
		status = "okay";
	};
};


&i2c4 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c4>;
	status = "okay"; 

	i2c-switch@70 {
		compatible = "nxp,pca9543";
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&gpios_exp 10 GPIO_ACTIVE_LOW>;
		reg = <0x70>;
		
	    i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			

		};
		
		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
		};
		
	};
	
};


&irqsteer_hdmi {
	status = "okay";
};

&hdmi_blk_ctrl {
	status = "okay";
};

&hdmi_pavi {
	status = "okay";
};

&hdmi {
	status = "okay";
};

&hdmiphy {
	status = "okay";
};

&lcdif1 {
	status = "disabled";
};

&lcdif2 {
	status = "disabled";
};

&lcdif3 {
	status = "okay";

	thres-low  = <1 2>;             /* (FIFO * 1 / 2) */
	thres-high = <3 4>;             /* (FIFO * 3 / 4) */
};


